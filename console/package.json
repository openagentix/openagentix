{
    "name": "openagentix-console",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "license": "Apache-2.0",
    "packageManager": "pnpm@11.13.1",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "vite dev",
        "build": "vite build && node scripts/externalize-boot.mjs",
        "preview": "vite preview",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "lint": "prettier --check . && eslint .",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "@eslint/js": "9.39.5",
        "@playwright/test": "1.65.1",
        "@sveltejs/adapter-static": "3.0.11",
        "@sveltejs/kit": "2.70.4",
        "@sveltejs/vite-plugin-svelte": "6.2.4",
        "@tailwindcss/vite": "4.3.5",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/svelte": "5.4.2",
        "@testing-library/user-event": "14.6.13",
        "@types/node": "22.19.1",
        "axe-core": "4.14.1",
        "eslint": "9.39.5",
        "eslint-plugin-svelte": "3.24.1",
        "globals": "17.14.0",
        "jsdom": "26.1.0",
        "prettier": "3.10.1",
        "prettier-plugin-svelte": "3.5.1",
        "svelte": "5.59.1",
        "svelte-check": "4.7.8",
        "tailwindcss": "4.3.5",
        "typescript": "5.9.3",
        "typescript-eslint": "8.74.0",
        "vite": "7.3.8",
        "vitest": "4.1.11"
    }
}
