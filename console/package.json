        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "lint": "prettier --check . && eslint .",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@playwright/test": "1.65.1",
        "@sveltejs/adapter-static": "4.0.1",
